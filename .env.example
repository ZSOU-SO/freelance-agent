# Optional. Leave empty to use the local fallback pipeline.
OPENAI_API_KEY=

# Optional. Set this for DeepSeek's OpenAI-compatible API.
OPENAI_BASE_URL=https://api.deepseek.com

# Optional. When unset, the Agents SDK default model is used.
OPENAI_MODEL=deepseek-flash

DATABASE_PATH=backend/data/freelance_agent.sqlite3
PRICING_RULES_PATH=backend/pricing_rules.json
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
